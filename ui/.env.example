# Copy to ui/.env.local if you need to change anything (never commit .env files).

# true = run on the scripted demo data in src/mocks (offline backup). Default: real backend.
VITE_USE_MOCK=false

# Leave empty: the dev server proxies /api to the backend (see vite.config.ts).
VITE_API_BASE_URL=

# Where the dev-server proxy sends /api (read by vite.config.ts, not by the browser).
CHAUKAS_API_URL=http://127.0.0.1:8000
