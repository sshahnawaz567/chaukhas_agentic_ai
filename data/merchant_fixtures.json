{
  "_meta": {
    "version": "v3",
    "conventions": {
      "money": "INTEGER rupees",
      "relative_dates": "days_ago / bank_details_updated_days_ago are relative to seed time; data/seed.py converts them to ISO-8601 UTC so 'pichle hafte' always works on demo day",
      "gmv_vs_inflow": "gmv_30d = gross sales value; cashflow.inflow_30d = net credited after refunds, MDR and holds",
      "pii": "all PII is synthetic; never commit real merchant data",
      "expected_loan_eligibility": "NOT a stored fact - the expected output of the simulated lender, used as test oracle"
    },
    "simulated_lender": {
      "note": "MOCK of an external lender's underwriting model. In production the regulated lender decides eligibility and amount (RBI digital lending guidelines); Chaukas only consumes {eligible, max_amount, reason_codes}. All thresholds are PLACEHOLDERS, calibration pending with lender data.",
      "config": "config/lender_sim.yaml",
      "eligible_if": "avg_balance >= 20000 AND account_age_months >= 11 AND inflow_cv <= 0.45 AND active_days_30d >= 25",
      "max_amount": "min(floor(0.30 * inflow_30d to multiple of 5000), max_loan_cap)",
      "max_loan_cap_inr": 200000,
      "reason_codes": [
        "AVG_BALANCE_OK|AVG_BALANCE_LOW",
        "ACCOUNT_AGE_OK|ACCOUNT_TOO_NEW",
        "INFLOW_STEADY|INFLOW_VOLATILE",
        "ACTIVE_DAYS_OK|ACTIVE_DAYS_LOW"
      ],
      "not_used": "withdrawals_30d and outflow_30d are context only, never eligibility signals"
    },
    "offer_gating": {
      "owner": "Chaukas guardrail (not the lender) - decides WHETHER and WHEN to offer",
      "rules": [
        "lender eligible else BLOCK OFFER_NOT_ELIGIBLE",
        "support issue of this session resolved or actioned (retriggered counts) else BLOCK ISSUE_UNRESOLVED",
        "no open handoff and kyc_status = verified else BLOCK ISSUE_UNRESOLVED",
        "no declined offer in last offer_cooling_off_days (7) else BLOCK OFFER_COOLING_OFF",
        "merchant consent else NEEDS_CONFIRMATION CONSENT_REQUIRED"
      ],
      "llm_input": "only reason_codes and the offer amount - never raw cashflow figures"
    },
    "guardrail_limits": {
      "auto_limit_inr": 25000,
      "daily_auto_limit_inr": 25000,
      "comparison": "amount <= limit -> ALLOW"
    },
    "cause_to_plan": {
      "IFSC_MISMATCH": "retrigger only if bank_details_updated_at is after the failure; else ask merchant to update bank details + handoff",
      "BANK_DOWN/failed": "retrigger_payout (guardrail decides limits)",
      "BANK_DOWN/pending": "do NOT retrigger; give ETA + update/raise ticket",
      "KYC_PENDING": "never retrigger; update/raise ticket + handoff; reply contains a static KYC link (no send_kyc_link action)"
    }
  },
